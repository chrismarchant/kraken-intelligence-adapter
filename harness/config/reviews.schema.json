{
  "$comment": "Subset JSON Schema, validated by harness/scripts/lib.mjs (validateSchema).",
  "type": "object",
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gate", "commit", "reviewer", "author", "independent", "scope", "skipped", "verdict", "findings", "reportPath", "at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "reviewer": {
            "type": "object",
            "required": ["kind", "id"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["agent", "model", "service", "human"] },
              "id": { "type": "string", "minLength": 1 },
              "model": { "type": "string" }
            }
          },
          "author": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string", "minLength": 1 } }
          },
          "independent": { "type": "boolean" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "reason"],
              "additionalProperties": false,
              "properties": { "path": { "type": "string" }, "reason": { "type": "string" } }
            }
          },
          "verdict": { "type": "string", "enum": ["approve", "approve-with-followups", "changes-requested", "failed", "unavailable"] },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "severity", "summary", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
                "summary": { "type": "string" },
                "status": { "type": "string", "enum": ["open", "fixed", "accepted", "wontfix"] },
                "remediationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          },
          "reportPath": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
